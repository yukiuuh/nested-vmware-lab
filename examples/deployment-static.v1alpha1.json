{
  "apiVersion": "nvl.io/v1alpha1",
  "kind": "Deployment",
  "name": "lab-static",
  "providers": {
    "primary": {
      "kind": "static"
    }
  },
  "credentials": {
    "vm_admin_password": "VMware123!"
  },
  "install_sources": {
    "esxi_8u3_installer": {
      "type": "http_iso",
      "url": "https://repo.example.local/iso/VMware-VMvisor-Installer-8.0U3-24022510.x86_64.iso"
    }
  },
  "routers": {
    "router_a": {
      "placement": {
        "provider": "primary"
      },
      "networks": {
        "lan": {
          "domain_name": "nested.lab",
          "network": "10.0.0.0",
          "gateway": "10.0.0.1"
        }
      }
    }
  },
  "storages": {},
  "esxi_groups": {
    "management_a": {
      "router": "router_a",
      "placement": {
        "provider": "primary"
      },
      "count": 1,
      "hostname_prefix": "esxi",
      "starting_ip": "10.0.0.101",
      "domain_name": "nested.lab",
      "install": {
        "method": "ansible_router_pxe",
        "source": {
          "install_source": "esxi_8u3_installer"
        },
        "kickstart": {
          "template": "esxi-8.0"
        }
      }
    }
  },
  "vcenters": {}
}
